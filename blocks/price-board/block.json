{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mrnpe/price-board",
	"version": "1.4.1",
	"title": "تابلوی نرخ MRN",
	"category": "widgets",
	"icon": "chart-line",
	"description": "نمایش زنده نرخ‌های محلی طلا، ارز، سکه و رمزارز.",
	"textdomain": "mrn-gold-currency-pricing",
	"attributes": {
		"title": { "type": "string", "default": "قیمت لحظه‌ای بازار" },
		"assets": { "type": "string", "default": "" },
		"layout": { "type": "string", "default": "cards" },
		"theme": { "type": "string", "default": "auto" },
		"columns": { "type": "number", "default": 3 },
		"showChange": { "type": "boolean", "default": true },
		"showUpdated": { "type": "boolean", "default": true }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	}
}
